import java.util.*;
class Main{
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        String name=sc.nextLine();
        int age=sc.nextInt();
        float height=sc.nextFloat();
        System.out.printf("Name:%s,Age:%d,Height:%.2f",name,age,height);
        sc.close();
        
    }
}
