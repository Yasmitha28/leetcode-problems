class Solution {
    public List<Integer> findMissingElements(int[] nums){
    Arrays.sort(nums);
    List<Integer> ans=new ArrayList<>();
    for(int i=0;i<nums.length-1;i++){
        int next=nums[i]+1;
        while(next<nums[i+1]){
            ans.add(next);
            next++;
        }
    } 
        return ans;
        
    }
}
